{
  "runtime.version": "Lua 5.3",
  "workspace": {
    "checkThirdParty": false
  },
  "diagnostics": {
    "globals": [
      "game",
      "Color",
      "Enum",
      "script",
      "typeof",
      "printerr",
      "ClientUIControl",
      "ClientUICursorAreaControl"
    ],
